# Copia este archivo como .env y ajusta los valores. Nunca subas el .env al repositorio.
DB_NAME=ozin
DB_USERNAME=ozin
DB_PASSWORD=ozin
DB_PORT=5432

# Variables que lee el backend (java -jar no carga este archivo: expórtalas en la terminal).
# Secreto de firma de los JWT, obligatorio y de al menos 32 caracteres. Generar con: openssl rand -base64 48
OZIN_JWT_SECRET=
# Administrador inicial. Se crea al arrancar si ese email todavía no existe.
OZIN_ADMIN_EMAIL=
OZIN_ADMIN_PASSWORD=
# Orígenes permitidos por CORS, separados por comas.
OZIN_ALLOWED_ORIGINS=http://localhost:4200
